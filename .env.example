# Application Environment
APP_ENV=local
APP_NAME=Smart Logistics Platform
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & Bypass
DEV_AUTH_BYPASS=true

# Auto-Batching Configuration
AUTO_BATCH_ENABLED=true
AUTO_BATCH_INTERVAL_SECONDS=30
AUTO_BATCH_MIN_ORDERS=1
AUTO_BATCH_MAX_WAIT_SECONDS=120
AUTO_BATCH_MAX_ORDERS=5
AUTO_BATCH_MAX_WEIGHT_KG=50.0
AUTO_BATCH_MAX_VOLUME_CBM=2.0

# Database Configuration (MySQL 8.0)
DATABASE_URL=mysql+pymysql://smart_logistics:Varun123@localhost:3306/smart_logistics
MYSQL_USER=smart_logistics
MYSQL_PASSWORD=Varun123
MYSQL_DB=smart_logistics
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Security & Authentication
JWT_SECRET=supersecret_jwt_key_change_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Provider Abstractions (Mocked for local development)
LLM_PROVIDER=mock
LLM_API_KEY=
MAP_PROVIDER=mock
WEATHER_PROVIDER=mock
TRAFFIC_PROVIDER=mock

# Safety & Telemetry Configuration
SAFETY_ALERT_SCORE=70.0

# Simulator Configuration (Default True when APP_ENV is local/staging; False in prod)
SIMULATOR_ENABLED=true
SIM_INTERVAL_SECONDS=2
SIM_SPEED_MULTIPLIER=10.0
EV_CONSUMPTION_KWH_PER_KM=0.12

# Charging Configuration
CHARGING_SLOT_HORIZON_HOURS=24
LOW_SOC_THRESHOLD=25.0

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]